rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 4.1: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    // Validation Blueprint for UsageLog
    function isValidUsageLog(data) {
      return data.keys().hasAll(['userId', 'actionType', 'createdAt']) &&
             data.keys().size() <= 4 &&
             data.userId == request.auth.uid &&
             data.actionType is string && data.actionType.size() <= 50 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 256)) &&
             data.createdAt == request.time;
    }

    // Phase 4: Route Definitions
    match /usageLogs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
                       isValidId(logId) && 
                       isValidUsageLog(incoming());
      allow update: if false; // Immutable logs
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
